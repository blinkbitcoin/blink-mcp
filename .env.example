# Required: Blink API key with appropriate permissions
# Get your key at https://dashboard.blink.sv (Settings > API Keys)
# Permissions needed:
#   READ   — for balance, transaction, price queries
#   RECEIVE — for creating invoices
#   WRITE  — for sending payments (Lightning, on-chain, intraledger)
BLINK_API_KEY=your_blink_api_key_here

# Optional: Network (mainnet or staging, defaults to mainnet)
# Use staging for testing against https://api.staging.blink.sv
BLINK_NETWORK=mainnet

# ─────────────────────────────────────────────────────────────────────────────
# Security controls (spend guard). Safe-by-default: with none of these set,
# every money-moving tool still requires explicit confirmation before it runs.
# ─────────────────────────────────────────────────────────────────────────────

# Require human confirmation before any spend tool executes (default: true).
# When the MCP client supports elicitation, a prompt is shown inline. Otherwise
# a two-step confirm-token flow is used: the first call returns a token that
# must be echoed back in a second call with identical arguments.
# BLINK_REQUIRE_CONFIRMATION=true

# Per-transaction cap in sats. Payments above this are refused.
# BLINK_MAX_PAYMENT_SATS=100000

# Rolling 24h spend cap in sats across all spend tools.
# BLINK_DAILY_BUDGET_SATS=500000

# Comma-separated recipient allowlist (ln addresses, usernames, btc addresses,
# wallet IDs). When set, sends to anything not listed are refused.
# BLINK_RECIPIENT_ALLOWLIST=alice@blink.sv,bc1qexampleaddress

# Comma-separated allowlist of webhook callback hostnames. add_webhook always
# requires https; when this is set the host must also be listed.
# BLINK_WEBHOOK_ALLOWLIST=hooks.mysite.com

# Mandatory default spend cap for l402_pay in sats when the caller omits
# max_amount_sats (default: 1000). l402_pay refuses invoices whose amount
# cannot be decoded.
# BLINK_L402_MAX_SATS=1000

# Optional comma-separated allowlist of hostnames l402_pay/l402_discover may
# fetch. Non-HTTPS and private/loopback/link-local addresses are always blocked.
# BLINK_L402_HOST_ALLOWLIST=api.example.com,l402.directory
